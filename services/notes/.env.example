# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Values containing $ must be wrapped in single quotes: NOTES_PASSWORD='pa$$word'

# --- Access (strongly recommended) ---
# Browser login for the inbox page.
NOTES_USER=
NOTES_PASSWORD=
# Token the Mac app and iPhone Shortcut send. Generate one with: openssl rand -hex 24
NOTES_TOKEN=

# --- Gemma (optional) ---
# Google AI Studio key for Gemma on the Gemini API (the default AI provider).
GEMINI_API_KEY=

# --- TacticsFreeZone power rankings from Gmail (optional) ---
# Gmail address and an app password (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Addresses that forwarded older TFZ issues into that inbox, comma-separated.
TFZ_FORWARDED_FROM=

# --- Tuning (optional) ---
# FEED_INTERVAL_MINUTES=30
# First-run default for the weekly rankings sync (then set in the app). Empty turns it off.
# RANKINGS_SYNC_SCHEDULE=Tue 16:00
# RANKINGS_SYNC_TZ=UTC
